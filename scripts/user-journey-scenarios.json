    {
      "id": "large-awol-detail-preview",
      "persona": "operator",
      "category": "detail-list",
      "description": "Broad exact-row requests should preview in chat and preserve the full CSV artifact.",
      "turns": [
        {
          "prompt": "List every AWOL incident from May through June by community, including resident name, date, incident type, and description",
          "expect": {
            "tools": ["incident_detail_list"],
            "periodIncludes": ["2026-05", "2026-06"],
            "categoryIncludes": "AWOL/Elopement",
            "artifact": true,
            "visual": {
              "type": "table",
              "minRows": 1,
              "maxRows": 50,
              "requiresOriginalRowCount": true
