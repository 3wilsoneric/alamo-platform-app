{
  "version": "user-journey-qa-v1",
  "minimumOverallScore": 88,
  "minimumTurnScore": 82,
  "description": "Operator-style journey checks that score intent, data scope, answer quality, surfaced modules, display hygiene, recovery behavior, and trust.",
  "journeys": [
    {
      "name": "Quick Resident Lookup",
      "intent": "Find one resident, confirm identity, and open the profile card without forcing page navigation.",
      "modes": ["quick_lookup", "surface"],
      "surfaces": ["Resident Search", "Resident Profile"],
      "scenarioIds": ["resident-search-surface", "resident-profile-card", "resident-no-match-recovery", "resident-to-community-thread"]
    },
    {
      "name": "Community Pulse Check",
      "intent": "Ask how a community is doing and get a compact census, incident, resident, and operating snapshot.",
      "modes": ["summary", "drilldown"],
      "surfaces": ["Community Profile", "Census Trend", "Incident Breakdown", "Diagnosis Mix", "Length Of Stay Mix"],
      "scenarioIds": ["community-profile-plain-language", "community-census-typo", "community-mover-scan", "diagnosis-mix-lookup", "los-mix-lookup", "long-community-operator-review", "resident-to-community-thread"]
    },
    {
      "name": "Incident Triage",
      "intent": "Understand incident volume, categories, residents involved, freshness, and exact event rows.",
      "modes": ["quick_lookup", "detail_list", "freshness"],
      "surfaces": ["Incident Center", "Incident Breakdown", "Incident Detail List", "Incident Freshness"],
      "scenarioIds": ["incident-freshness", "awol-people-count", "incident-category-review", "large-awol-detail-preview", "long-incident-detail-session", "resident-to-community-thread"]
    },
    {
      "name": "Trend And Movement Review",
      "intent": "Compare periods, identify movers, and explain what changed without inventing commentary.",
      "modes": ["comparison", "trend"],
      "surfaces": ["Census Movement", "Census Trend", "Incident Category Comparison", "Incident Rate Change"],
      "scenarioIds": ["detail-list-followups", "incident-rate-change-review", "multi-domain-compare"]
    },
    {
      "name": "Exact Rows And Export",
      "intent": "Get the underlying rows safely, preview only enough in chat, and preserve the complete CSV row set.",
      "modes": ["detail_list", "export"],
      "surfaces": ["Detail List", "CSV Artifact", "Preview Table"],
      "scenarioIds": ["large-awol-detail-preview", "detail-list-followups", "long-incident-detail-session"]
    },
    {
      "name": "Data Trust And Recovery",
      "intent": "Explain unavailable, stale, unsupported, or ambiguous data and offer the closest valid path.",
      "modes": ["recovery", "freshness", "clarification"],
      "surfaces": ["Data Availability", "Clarification", "Closest Valid Slice"],
      "scenarioIds": ["unsupported-period-recovery", "data-availability-window", "ambiguous-resident-guardrail", "resident-no-match-recovery", "recovery-period-pivot-session"]
    },
    {
      "name": "Medication Signal Review",
      "intent": "Check medication compliance, refusals, and follow-up slices when MAR-derived context is loaded.",
      "modes": ["summary", "followup"],
      "surfaces": ["Medication Profile", "Medication Compliance", "Medication Refusals"],
      "scenarioIds": ["medication-profile-followups"]
    },
    {
      "name": "Surface-Only Use",
      "intent": "Use the platform like a vertical website by opening prepared surfaces directly from chat.",
      "modes": ["surface"],
      "surfaces": ["Resident Search", "Incident Center", "Community Detail"],
      "scenarioIds": ["resident-search-surface", "surface-incident-center", "surface-community-resident-search"]
    },
    {
      "name": "Operating Snapshot",
      "intent": "Get a fast portfolio-level operating read without opening several modules or pages.",
      "modes": ["summary"],
      "surfaces": ["Operating Snapshot", "Communities Overview", "Incident Center"],
      "scenarioIds": ["operating-snapshot-scan"]
    },
    {
      "name": "Inevitable Analyst Layer",
      "intent": "Handle loose operator language by finding the closest valid slice, answering from deterministic tools, and keeping surfaces scoped.",
      "modes": ["summary", "trend", "slice", "recovery"],
      "surfaces": ["Community History", "Slice Discovery", "Module Coverage", "Data Availability"],
      "scenarioIds": ["community-history-loose-language", "slice-discovery-freeform", "trace-coverage-command-center", "fresh-thread-context-reset"]
    }
  ],
  "scenarios": [
    {
      "id": "resident-search-surface",
      "persona": "operator",
      "category": "surface",
      "description": "A user asks for resident search as a module, not as a failed resident lookup.",
      "turns": [
        {
          "prompt": "resident search",
          "promptVariants": [
            "find a resident",
            "show me the resident search module",
            "can i just get the search census module"
          ],
          "expect": {
            "tools": ["surface_module"],
            "textIncludes": ["Opened Resident Search"],
            "textExcludes": ["No resident matched", "Matched 12 rows", "Victoria's Place"],
            "actionsIncludeRoute": "/resident-search",
            "maxActions": 2,
            "direct": true
          }
        }
      ]
    },
    {
      "id": "awol-people-count",
      "persona": "operator",
      "category": "incidents",
      "description": "A people-count question should count unique residents, not incident rows.",
      "turns": [
        {
          "prompt": "how many people went AWOL in May 2026",
          "promptVariants": [
            "total AWOL residents last month, May 2026",
            "how many clients went awol in may 2026"
          ],
          "expect": {
            "tools": ["incident_breakdown"],
            "period": "2026-05",
            "categoryIncludes": "AWOL/Elopement",
            "valueLabel": "Residents",
            "textIncludes": ["unique resident", "May 2026"],
            "textExcludes": ["Victoria's Place", "facility 337"],
            "visual": {
              "minRows": 1,
              "valueLabel": "Residents"
            },
            "direct": true,
            "maxActions": 2
          }
        }
      ]
    },
    {
      "id": "community-census-typo",
      "persona": "operator",
      "category": "census",
      "description": "Typos should be interpreted safely and still route to the specific community trend.",
      "turns": [
        {
          "prompt": "show santa clartia censsus trend",
          "expect": {
            "tools": ["census_trend"],
            "facilityId": "345",
            "period": "2026-06",
            "textIncludes": ["Santa Clarita", "June 2026"],
            "textExcludes": ["Portfolio census trend", "Victoria's Place"],
