          "prompt": "do that for April now",
          "expect": {
            "tools": ["incident_detail_list"],
            "period": "2026-04",
            "categoryIncludes": "AWOL/Elopement",
            "artifact": true,
            "textExcludes": ["not enough context", "What would you like"],
            "maxActions": 2
          }
        },
        {
          "prompt": "now San Pablo",
          "expect": {
            "tools": ["incident_detail_list"],
            "facilityId": "337",
            "categoryIncludes": "AWOL/Elopement",
            "textIncludes": ["A & A Health Services San Pablo"],
            "textExcludes": ["not enough context", "Portfolio AWOL"],
            "maxActions": 2
          }
        },
        {
          "prompt": "just totals",
          "expect": {
            "tools": ["incident_breakdown", "slice_metric"],
            "facilityId": "337",
            "categoryIncludes": "AWOL/Elopement",
            "textExcludes": ["not enough context", "every loaded matching incident"],
            "direct": true,
            "maxActions": 2
          }
        }
      ]
    },
