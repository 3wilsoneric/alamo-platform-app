{
  "version": "2.0",
  "functionTimeout": "00:05:00",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.0.0, 5.0.0)"
  },
  "extensions": {
    "durableTask": {
      "hubName": "AlamoAgentV1",
      "maxConcurrentActivityFunctions": 4,
      "maxConcurrentOrchestratorFunctions": 4,
      "storageProvider": { "type": "azureStorage" },
      "tracing": { "traceInputsAndOutputs": false, "traceReplayEvents": false }
    }
  },
  "logging": {
    "logLevel": { "default": "Warning", "Host.Results": "Information" },
    "applicationInsights": { "samplingSettings": { "isEnabled": true } }
  }
}
