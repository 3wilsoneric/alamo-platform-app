# Alamo Platform environment template
# Fill these in locally or in Vercel project settings.

# Microsoft Entra
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
# Delegated API authorization. Production and Vercel previews always require auth.
API_AUTH_REQUIRED=
ENTRA_API_AUDIENCE=
ENTRA_API_SCOPE=access_as_user
# Optional defense in depth. When set, delegated tokens must contain this Entra app role.
ENTRA_API_REQUIRED_ROLE=

# Pipeline clinical integration authorization. Delegated tokens need the scope;
# service-principal tokens need the app role. The integration accepts either.
PIPELINE_CLINICAL_API_SCOPE=Pipeline.Clinical.Read
PIPELINE_CLINICAL_API_ROLE=Pipeline.Clinical.Read.All
# The integration has a stricter freshness target and a bounded response size.
PIPELINE_CLINICAL_SNAPSHOT_MAX_AGE_HOURS=24
PIPELINE_CLINICAL_API_MAX_RESPONSE_BYTES=2097152

# Browser-safe Entra vars for the Vite frontend
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_API_SCOPE=
# Local-development opt-in. Production builds always require delegated API auth.
VITE_API_AUTH_REQUIRED=
# Local browser QA only. Ignored by production builds.
VITE_E2E_AUTH_BYPASS=false
# Browser-safe URL for the separate Azure-hosted admissions application.
VITE_PIPELINE_APP_URL=https://alamo-pipeline.com

# Local development ports and API proxy
API_PORT=3002
VITE_API_PROXY_TARGET=http://localhost:3002
# Optional comma-separated override. By default, loopback-only localhost,
# 127.0.0.1, and [::1] origins are accepted on any development port.
DEV_API_ALLOWED_ORIGINS=

# Databricks
# Current project values are filled where they are already known.
DATABRICKS_HOST=https://adb-7405608024417459.19.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/f7abfd1e8b6c6b4d
DATABRICKS_SQL_WAREHOUSE_ID=
DATABRICKS_CATALOG=alamohealth
DATABRICKS_SCHEMA=gold

# Preferred long-term auth for Databricks
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# Development-only fallback.
# Production code paths should use Databricks OAuth and leave this unset.
DATABRICKS_TOKEN=
ALLOW_DATABRICKS_PAT_IN_DEV=false

# Snapshot / cache storage
# Production snapshot contract:
#   snapshots/daily/latest.json
#   snapshots/daily/YYYY-MM-DD.json
AZURE_STORAGE_ACCOUNT=alamodatalake
AZURE_STORAGE_CONTAINER=alamo-platform-snapshots
AZURE_STORAGE_CONNECTION_STRING=
SNAPSHOT_ROOT=snapshots/daily

# Snapshot runtime behavior
PLATFORM_SNAPSHOT_REQUIRED=false
PLATFORM_SNAPSHOT_MAX_AGE_HOURS=30
PLATFORM_SNAPSHOT_MAX_BYTES=67108864
PLATFORM_CLIENT_DATABASE_MAX_BYTES=16777216
PLATFORM_SNAPSHOT_CACHE_TTL_MS=300000
PLATFORM_SNAPSHOT_READ_SOURCE=
PLATFORM_SNAPSHOT_ALLOW_EMPTY_TOOL_CONTEXT=false

# Analyst synthesis and bounded runtime behavior
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=1200
ANTHROPIC_TIMEOUT_MS=35000
ANTHROPIC_MAX_ATTEMPTS=2
COPILOT_ASSISTANT_LABEL=Alamo Analyst
ALLOW_DETERMINISTIC_CLAUDE_OVERRIDE=false
CERTIFIED_ANSWER_CACHE_ENABLED=true
# Re-check the local certified answer cache periodically so a newly published cache
# is picked up without restarting the API process.
CERTIFIED_ANSWER_CACHE_RECHECK_MS=30000
ANALYST_TRACE_MAX_RECORDS=1000
ANALYST_TRACE_SLOW_MS=2500

# Governed one-page briefs
# Claude may rewrite verified evidence into concise prose, but cannot select
# rows or introduce numbers. Set false for deterministic-only report prose.
GOVERNED_REPORT_SYNTHESIS_ENABLED=true
# Email is optional. Without all three values, reports remain download/print only.
REPORT_EMAIL_WEBHOOK_URL=
REPORT_EMAIL_WEBHOOK_SECRET=
REPORT_EMAIL_ALLOWED_DOMAINS=alamohealth.com
REPORT_EMAIL_TIMEOUT_MS=12000

# Weekly governed briefings
# Vercel sends CRON_SECRET as a Bearer token to the scheduled endpoint.
CRON_SECRET=
WEEKLY_BRIEFING_SCHEDULE_LABEL=Mondays
WEEKLY_BRIEFING_EXECUTIVE_RECIPIENTS=
WEEKLY_BRIEFING_OPERATIONS_RECIPIENTS=
WEEKLY_BRIEFING_CLINICAL_RECIPIENTS=
# JSON object keyed by facility ID or exact community name. Values may be a
# comma-separated string or an array of approved organization email addresses.
WEEKLY_BRIEFING_COMMUNITY_RECIPIENTS_JSON={}
