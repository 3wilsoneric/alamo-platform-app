{
  "name": "alamo-platform-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19 <23"
  },
  "overrides": {
    "ip-address": "10.4.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch --env-file=.env server/dev-api.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "snapshot:generate": "node scripts/generate-platform-snapshot.mjs",
    "snapshot:publish": "PLATFORM_SNAPSHOT_PUBLISH_AZURE=true node scripts/generate-platform-snapshot.mjs",
    "cache:certified": "node scripts/generate-certified-answer-cache.mjs",
    "qa:analyst": "node scripts/generate-analyst-qa.mjs",
    "check:query-understanding": "node scripts/check-query-understanding.mjs",
    "check:query-intent": "node scripts/check-query-intent-compiler.mjs",
    "check:query-matrix": "node scripts/check-query-intent-matrix.mjs",
    "check:copilot-tools": "node scripts/check-copilot-tool-scope.mjs",
    "check:module-registry": "node scripts/check-module-registry.mjs",
    "check:ad-hoc-modules": "node scripts/check-ad-hoc-module-planner.mjs",
    "check:visual-modules": "node scripts/check-visual-module-fixtures.mjs",
    "check:module-benchmark": "node scripts/check-module-selection-benchmark.mjs",
    "check:analysis-state": "node scripts/check-analysis-session-state.mjs",
    "check:thread-transitions": "node scripts/check-thread-transition-matrix.mjs",
    "check:thread-context-fuzz": "node scripts/check-thread-context-fuzz.mjs",
    "check:answer-formatting": "node scripts/check-answer-formatting.mjs",
    "check:answer-contracts": "node scripts/check-answer-contracts.mjs",
    "check:answer-quality": "node scripts/check-answer-quality.mjs",
    "check:data-depth": "node scripts/check-data-depth-contracts.mjs",
    "check:weekly-analysis": "node scripts/check-weekly-analysis.mjs",
    "check:eldermark-dates": "node scripts/check-eldermark-date-contracts.mjs",
    "check:databricks-serverless": "node scripts/check-databricks-serverless.mjs",
    "check:turn-traces": "node scripts/check-turn-trace-store.mjs",
    "check:auth-redirect": "node scripts/check-auth-redirect-contract.mjs",
    "check:fiftystate": "node scripts/check-fifty-state-atlas.mjs",
    "check:reports": "node scripts/check-reports-page.mjs",
    "check:full-reports": "node scripts/check-full-reporting.mjs",
    "check:platform-api": "npm run check:auth-redirect && node scripts/check-platform-api-boundaries.mjs",
    "check:pipeline-clinical": "node scripts/check-pipeline-clinical-api.mjs",
    "check:admissions-access": "node scripts/check-admissions-access.mjs",
    "check:regression-replays": "node scripts/check-regression-replays.mjs",
    "check:operator-prompts": "node scripts/check-operator-prompts.mjs",
    "check:question-catalog": "node scripts/check-certified-question-catalog.mjs",
    "check:question-search-routing": "node scripts/check-question-search-routing.mjs",
    "check:guided-report-shape": "node scripts/check-guided-answer-report-shape.mjs",
    "check:governed-reports": "node scripts/check-governed-reporting.mjs",
    "check:user-journeys": "node scripts/check-user-journeys.mjs",
    "check:user-journey-stress": "node scripts/check-user-journey-stress.mjs",
    "check:user-journey-fuzz": "node scripts/check-user-journey-fuzz.mjs",
    "check:user-missions": "node scripts/check-user-missions.mjs",
    "check:browser-missions": "node scripts/check-browser-missions.mjs",
    "check:browser-community-surfaces": "node scripts/check-browser-community-surfaces.mjs",
    "check:browser-community-questions": "node scripts/check-browser-community-questions.mjs",
    "check:browser-full-reports": "node scripts/check-browser-full-reports.mjs",
    "check:browser-surfaces": "npm run check:browser-community-surfaces && npm run check:browser-community-questions && node scripts/check-browser-surfaces.mjs",
    "check:browser-mar": "PLATFORM_SNAPSHOT_READ_SOURCE=azure BROWSER_SURFACE_INCLUDE_MAR=true node --env-file=.env scripts/check-browser-surfaces.mjs",
    "check:browser-explorer": "node scripts/check-browser-explorer.mjs",
    "check:browser-chat-flow": "node scripts/check-browser-chat-flow.mjs",
    "check:browser-mobile": "node scripts/check-browser-mobile.mjs",
    "check:browser-question-families": "npm run check:guided-report-shape && npm run cache:certified && node scripts/check-browser-question-families.mjs",
    "check:browser-all-guided-answers": "npm run check:guided-report-shape && npm run cache:certified && node scripts/check-browser-all-guided-answers.mjs",
    "check:browser-guided-accessibility": "node scripts/check-browser-guided-accessibility.mjs",
    "check:browser-guided-interactions": "node scripts/check-browser-guided-interactions.mjs",
    "check:thread-context-ux": "node scripts/check-thread-context-ux.mjs",
    "check:thread-context-stress": "node scripts/check-thread-context-stress.mjs",
    "check:browser-clutter": "node scripts/check-browser-clutter.mjs",
    "check:browser-journey-fuzz": "node scripts/check-browser-journey-fuzz.mjs",
    "check:browser-journey-replay": "node scripts/replay-browser-journey-failure.mjs",
    "check:browser-performance": "node scripts/check-browser-performance.mjs",
    "check:browser-scroll": "node scripts/check-browser-scroll-snap.mjs",
    "check:california-home": "node scripts/check-california-home.mjs",
    "check:browser-california-home": "node scripts/check-browser-california-home.mjs",
    "check:browser-admissions": "node scripts/check-browser-admissions.mjs",
    "check:browser-california-carousel": "node scripts/check-browser-california-carousel.mjs",
    "check:production-smoke": "node scripts/check-production-smoke.mjs",
    "capture:production-auth": "node scripts/capture-production-auth-state.mjs",
    "check:production-signed-in-smoke": "node scripts/check-production-signed-in-smoke.mjs",
    "check:production-guided-questions": "node scripts/check-production-guided-questions.mjs",
    "check:platform-ready": "node scripts/check-platform-ready.mjs",
    "check:release": "BROWSER_QA_CLEAN_ROOM=true PRODUCTION_SIGNED_IN_REQUIRED=true PLATFORM_READY_PROFILE=release npm run check:platform-ready",
    "check:ship": "BROWSER_QA_CLEAN_ROOM=true PRODUCTION_SIGNED_IN_REQUIRED=true PLATFORM_READY_PROFILE=full PLATFORM_READY_INCLUDE_BUILD=true PLATFORM_READY_STOP_ON_FAILURE=true npm run check:platform-ready",
    "check:certified-rails": "npm run cache:certified && node scripts/check-certified-analyst-rails.mjs",
    "check:mar-analytics": "node scripts/check-mar-analytics.mjs",
    "check:mar-analytics:azure": "PLATFORM_SNAPSHOT_READ_SOURCE=azure node --env-file=.env scripts/check-mar-analytics.mjs",
    "check:docs": "node scripts/check-platform-docs.mjs && npm run check:retention",
    "check:retention": "node scripts/check-repository-retention.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc --project tsconfig.server.json",
    "check:source-syntax": "node scripts/check-source-syntax.mjs",
    "check:lint-js": "eslint api server shared scripts",
    "check:code-health": "node scripts/check-code-health.mjs",
    "check:unused": "knip --reporter compact",
    "check:duplicates": "jscpd src server shared api --min-lines 12 --min-tokens 80 --threshold 0 --reporters console --ignore '**/*.d.mts'",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:tool-registry": "node scripts/check-tool-registry.mjs",
    "check:analyst-capabilities": "node scripts/check-analyst-capabilities.mjs",
    "check:analyst-decision": "node scripts/check-analyst-decision-intelligence.mjs",
    "check:analysis-capability-guards": "node scripts/check-analysis-capability-guards.mjs",
    "check:analyst-capability-prompts": "node scripts/check-analyst-capability-prompts.mjs",
    "check:analysis-slice-catalog": "node scripts/check-analysis-slice-catalog.mjs",
    "check:incident-contracts": "node scripts/check-incident-tool-contracts.mjs",
    "check:analyst": "npm run typecheck && npm run typecheck:server && npm run check:source-syntax && npm run check:lint-js && npm run check:code-health && npm run check:retention && npm run check:unused && npm run check:duplicates && npm run check:tool-registry && npm run check:analyst-capabilities && npm run check:analyst-decision && npm run check:analysis-capability-guards && npm run check:analyst-capability-prompts && npm run check:analysis-slice-catalog && npm run check:incident-contracts && npm run check:module-registry && npm run check:query-understanding && npm run check:query-intent && npm run check:query-matrix && npm run check:copilot-tools && npm run check:ad-hoc-modules && npm run check:visual-modules && npm run check:module-benchmark && npm run check:analysis-state && npm run check:thread-transitions && npm run check:thread-context-fuzz && npm run check:answer-formatting && npm run check:answer-contracts && npm run check:answer-quality && npm run check:data-depth && npm run check:weekly-analysis && npm run check:eldermark-dates && npm run check:databricks-serverless && npm run check:turn-traces && npm run check:platform-api && npm run check:pipeline-clinical && npm run check:admissions-access && npm run check:operator-prompts && npm run check:question-catalog && npm run check:question-search-routing && npm run check:guided-report-shape && npm run check:governed-reports && npm run check:full-reports && npm run check:user-journeys && npm run check:user-journey-fuzz && npm run check:user-journey-stress && npm run check:certified-rails && npm run check:mar-analytics",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/msal-browser": "^4.26.0",
    "@azure/msal-react": "^3.0.20",
    "@azure/storage-blob": "^12.33.0",
    "@databricks/sql": "^2.0.0",
    "@svg-maps/usa": "^2.0.0",
    "jose": "^6.2.3",
    "lucide-react": "^0.525.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "eslint": "9.39.5",
    "globals": "^17.7.0",
    "jscpd": "^5.0.12",
    "knip": "^6.27.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^8.1.5"
  }
}
